# 开发环境变量样例（复制为 .env 使用；生产值由部署环境注入）
APP_NAME=geodata-console
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:geodata@localhost:5432/geodata
REDIS_URL=redis://localhost:6379/0
# 存储路线：object（Ceph RGW 主选）/ file（CephFS·NFS 备选），见技术方案第四章
STORAGE_ROUTE=object
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=geodata-hot
