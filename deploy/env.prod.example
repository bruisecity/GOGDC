# 生产环境变量样例 —— 复制到部署环境注入（值全部「待填真实信息」，禁止示例值上线）。
# 注入方式由部署环境决定（compose --env-file / 宿主环境 / 密钥管理）；
# 与 backend/app/config.py 的读取项一一对应，未列出的项走应用默认值。

APP_NAME=geodata-console
APP_ENV=prod

# 业务库（Alembic 迁移目标；search_path 由 migrations/env.py 锁定 public）
DATABASE_URL=postgresql+psycopg://<待填用户>:<待填密码>@<待填主机>:5432/geodata

REDIS_URL=redis://<待填主机>:6379/0

# pgSTAC 编目直连（与业务库同库，不同协议前缀）
PGSTAC_DSN=postgresql://<待填用户>:<待填密码>@<待填主机>:5432/geodata

# 存储路线：object（Ceph RGW 主选）/ file（CephFS·NFS 备选，需另给 STORAGE_DIR）
STORAGE_ROUTE=object
S3_ENDPOINT=<待填 Ceph RGW 地址，如 http://rgw.ceph.internal:8080>
S3_REGION=us-east-1
S3_BUCKET=<待填热桶名>
S3_WARM_BUCKET=<待填温桶名>
S3_COLD_BUCKET=<待填冷桶名>
S3_ACCESS_KEY=<待填>
S3_SECRET_KEY=<待填>
# STORAGE_DIR 仅 file 路线需要（object 路线忽略）
STORAGE_DIR=<待填，object 路线留空>

# 门户下载入口对外前缀（生成下载链接用）
PUBLIC_BASE_URL=<待填门户对外地址>

# 水位告警 webhook（逗号分隔多路；空=仅审计日志通道）
ALERT_WEBHOOK_URLS=<待填，可留空>
ALERT_WEBHOOK_TIMEOUT=10
ALERT_WEBHOOK_RETRIES=3

# 默认数据集分类编码（入库未指定分类时兜底）
DEFAULT_CATEGORY_CODE=elevation
